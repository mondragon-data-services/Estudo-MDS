# ---------------------------------------------------------------------------
# Regras que valem para TODAS as aulas.
# Regras específicas de uma aula ficam no .gitignore da própria pasta dela.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Ambientes virtuais (um por aula: aulas/<aula>/.venv)
.venv/
venv/
env/

# Segredos: cada pessoa cria o seu .env a partir do .env.example
.env
.env.*
!.env.example

# Sistema operacional / editores
.DS_Store
Thumbs.db
.vscode/
.idea/
