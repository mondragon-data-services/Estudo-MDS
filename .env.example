# Configuração compartilhada por TODAS as aulas.
# Copie para .env (na raiz do repositório):  cp .env.example .env
#
# Uma aula pode sobrescrever qualquer valor no .env da própria pasta
# (aulas/<aula>/.env) — o da aula tem prioridade sobre o da raiz.

# --- SQL Server: a instância que já existe na sua máquina ---------------------
# Instância nomeada:  .\NOME_DA_INSTANCIA   (ex.: .\DEV2022, .\SQLEXPRESS)
# Instância padrão:   localhost
# Via TCP/porta:      localhost,1433
SQL_SERVER=.\DEV2022

# Autenticação Windows (recomendado na máquina local: sem senha em arquivo).
SQL_TRUSTED_CONNECTION=yes

# Autenticação SQL: troque a linha acima para "no" e preencha usuário e senha.
SQL_USER=
SQL_PASSWORD=

ODBC_DRIVER=ODBC Driver 18 for SQL Server
